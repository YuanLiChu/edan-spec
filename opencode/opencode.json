{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/AGENTS.md",
    ".opencode/docs/**/*.md",
    ".opencode/rules/**/*.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow"
  },
  "agent": {
    "code-reviewer": {
      "description": "代码审查专家 Agent，执行四维度代码审查。",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/code-reviewer.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny"
      }
    },
    "security-reviewer": {
      "description": "安全审查专家 Agent，从五维度审查代码安全风险。",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/security-reviewer.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny"
      }
    }
  }
}
